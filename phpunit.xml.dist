<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd" bootstrap="./vendor/autoload.php" colors="true" cacheDirectory="./build/cache/phpunit">
  <testsuites>
    <testsuite name="kilbil-client">
      <directory>./tests</directory>
    </testsuite>
  </testsuites>
  <source restrictNotices="true" restrictWarnings="true">
    <include>
      <directory suffix=".php">./src</directory>
      <directory suffix=".php">./generated</directory>
    </include>
  </source>
  <php>
    <ini name="memory_limit" value="1G"/>
  </php>
</phpunit>
