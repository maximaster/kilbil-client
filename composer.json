{
    "name": "maximaster/kilbil-client",
    "description": "API-клиент для программы лояльности Kilbil.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "kilbil",
        "loyalty",
        "api-client",
        "openapi"
    ],
    "authors": [
        {
            "name": "Maxim Lavrinenko",
            "email": "maxim@lavrinenko.xyz"
        }
    ],
    "require": {
        "php": "^8.4",
        "poagen/client-runtime": "^0.1",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "devizzent/cebe-php-openapi": "^1.1",
        "friendsofphp/php-cs-fixer": "^3.92",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.1",
        "psr/http-client": "^1.0",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Maximaster\\Kilbil\\Generated\\": "generated/Generated/",
            "Maximaster\\Kilbil\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maximaster\\Kilbil\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": [
            "@lint:cs-fixer",
            "@lint:phpstan",
            "@lint:rector"
        ],
        "lint:cs-fixer": "php-cs-fixer fix --diff --verbose --dry-run",
        "lint:phpstan": "phpstan analyse --memory-limit=512M",
        "lint:rector": "rector --dry-run",
        "format": "php-cs-fixer fix --diff --verbose",
        "format:rector": "rector",
        "test": "phpunit"
    },
    "$schema": "https://getcomposer.org/schema.json"
}
